rules_version = '2';

// CareLoop reads and writes Firestore only from its server, using a service
// account (which is not subject to these rules). No browser or mobile client
// ever talks to Firestore directly, so all client access is denied. This also
// means nobody can edit or delete audit_events from outside the server.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
