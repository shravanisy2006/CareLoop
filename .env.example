# Copy this file to .env and fill in the values. Never commit .env.

# Signs session cookies. Required in production; at least 32 random characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
CARELOOP_SECRET_KEY=

# development (default) allows a temporary secret key; production refuses to start without one.
CARELOOP_ENV=development

# Storage: "sqlite" (default, no setup) or "firestore" (Google Cloud Firestore).
CARELOOP_STORAGE=sqlite
CARELOOP_SQLITE_PATH=careloop.db

# Only for CARELOOP_STORAGE=firestore:
# GOOGLE_CLOUD_PROJECT=your-firebase-project-id
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account-key.json
# To use the local emulator instead of the cloud:  FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Gmail sending. Needs 2-Step Verification on the Google account and an App Password
# (Google Account > Security > App passwords). Leave empty to record emails as "not_configured".
CARELOOP_GMAIL_ADDRESS=
CARELOOP_GMAIL_APP_PASSWORD=

# Base URL used in email links.
CARELOOP_PUBLIC_URL=http://127.0.0.1:8000

# Set to true when served over HTTPS so the session cookie is Secure.
CARELOOP_SECURE_COOKIES=false

# Background care cycle (dose generation, escalation, emails).
CARELOOP_SCHEDULER_ENABLED=true
CARELOOP_CYCLE_SECONDS=60

# Public demo only: creates a sample circle with public sign-ins and one-click buttons.
# Never turn this on for real people.
CARELOOP_DEMO_MODE=false

# Sign-in and sign-up attempts allowed per network address every 15 minutes.
CARELOOP_SIGN_IN_ATTEMPTS_PER_15_MIN=30

# Timezone pre-selected when starting a new care circle.
CARELOOP_DEFAULT_TIMEZONE=Asia/Kolkata
